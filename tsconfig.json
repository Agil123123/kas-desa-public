{
  "compilerOptions": {
    "target": "es2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"],
      "@kas/backend": ["backend/index.ts"]
    },
    "jsx": "preserve"
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/**/*.ts"
  ]
}
